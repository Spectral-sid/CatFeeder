<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- SurfaceView для камеры -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Затемненный оверлей с рамкой сканирования -->
    <FrameLayout
        android:id="@+id/preview_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000">

        <!-- Прозрачная область в центре для сканирования -->
        <RelativeLayout
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:layout_gravity="center">

            <!-- ВАЖНО: Добавляем focus_rect - центральную рамку фокуса -->
            <View
                android:id="@+id/focus_rect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/focus_rect" />

            <!-- Угловые маркеры -->
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/corner_top_left" />

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/corner_top_right" />

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/corner_bottom_left" />

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/corner_bottom_right" />

            <!-- Центральная линия-сканер -->
            <View
                android:id="@+id/scan_line"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_centerVertical="true"
                android:background="#4CAF50"
                android:alpha="0.8" />

        </RelativeLayout>

    </FrameLayout>

    <!-- Статус текст -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="50dp"
        android:text="🔍 Сканирование..."
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:background="#99000000"
        android:padding="12dp"/>

    <!-- Инструкция -->
    <TextView
        android:id="@+id/tv_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="50dp"
        android:text="Держите штрихкод в рамке"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:background="#99000000"
        android:padding="12dp"/>

</FrameLayout>