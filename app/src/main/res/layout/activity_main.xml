<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Статус сервера -->
        <TextView
            android:id="@+id/tv_server_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="Статус сервера: проверка..."
            android:textStyle="bold" />

        <!-- Выбор питомца -->
        <!-- Вместо Spinner добавьте: -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="16dp"
            android:text="Выберите питомцев:"

            android:textSize="16sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llPetsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбрано: 0 питомцев"
            android:textSize="14sp"
            android:textColor="#FF666666"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Сканировать штрихкод"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_barcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Штрихкод: не отсканирован"
            android:layout_marginBottom="4dp"
            android:textStyle="bold"/>

        <!-- Название корма -->
        <EditText
            android:id="@+id/et_food_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:hint="Название корма"
            android:inputType="text"
            android:minHeight="36dp" />

        <!-- Количество -->
        <!-- Вместо EditText et_amount добавьте это: -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Доля от веса пакета:"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgPortion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/rbPortion2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2"
                android:textSize="16sp"
                android:buttonTint="@color/purple_500"
                android:padding="8dp"
                android:gravity="center"/>

            <RadioButton
                android:id="@+id/rbPortion1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1"
                android:textSize="16sp"
                android:buttonTint="@color/purple_500"
                android:padding="8dp"
                android:gravity="center"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbPortionHalf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="½"
                android:textSize="16sp"
                android:buttonTint="@color/purple_500"
                android:padding="8dp"
                android:gravity="center"/>
        <!--   ⅓ -->
          <RadioButton
              android:id="@+id/rbPortionThird"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="1/3"
              android:textSize="16sp"
              android:buttonTint="@color/purple_500"
              android:padding="8dp"
              android:gravity="center"/>
            <!-- ¼  ⅓ -->
          <RadioButton
              android:id="@+id/rbPortionQuarter"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="1/4"
              android:textSize="16sp"
              android:buttonTint="@color/purple_500"
              android:padding="8dp"
              android:gravity="center"/>

      </RadioGroup>

      <!-- Текст для отображения рассчитанного веса -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:background="@color/light_gray_bg"
            android:padding="12dp"
            android:visibility="gone"
            android:id="@+id/llCalculatedWeight">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вес порции: "
                android:textSize="16sp"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvCalculatedWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 г"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/tvPerPet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="16dp"/>

        </LinearLayout>

        <!-- Сохранение -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить кормление"
            android:layout_marginBottom="16dp"/>

        <!-- Прогресс бар -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- История кормлений -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="История кормлений"

                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_refresh_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Обновить"
                android:src="@android:drawable/ic_menu_rotate"
                android:tooltipText="Обновить историю" />
        </LinearLayout>


        <!-- Добавьте после RecyclerView или в любое удобное место -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/tv_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:padding="32dp"
            android:gravity="center"
            android:text="Нет данных для отображения"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btn_AddFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить новый корм"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>