<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Светлая тема -->
    <style name="Theme.CatFeeder" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (purple_500 остается) -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Кастомные атрибуты для светлой темы -->
        <item name="customBackground">@color/light_background</item>
        <item name="customSurface">@color/light_surface</item>
        <item name="customTextPrimary">@color/light_text_primary</item>
        <item name="customTextSecondary">@color/light_text_secondary</item>
        <item name="customTextHint">@color/light_text_hint</item>
        <item name="customDivider">@color/light_divider</item>
        <item name="customCardBackground">@color/light_card_background</item>
        <item name="customIconTint">@color/light_icon_tint</item>

        <!-- ActionBar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="actionBarSize">56dp</item>
        <item name="actionBarStyle">@style/Widget.CatFeeder.ActionBar</item>

        <!-- EditText стиль -->
        <item name="editTextStyle">@style/Widget.CatFeeder.EditText</item>

        <!-- Button стиль -->
        <item name="materialButtonStyle">@style/Widget.CatFeeder.Button</item>
    </style>

    <!-- Темная тема -->
    <style name="Theme.CatFeeder.Dark" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (purple_500 остается) -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Кастомные атрибуты для темной темы -->
        <item name="customBackground">@color/dark_background</item>
        <item name="customSurface">@color/dark_surface</item>
        <item name="customTextPrimary">@color/dark_text_primary</item>
        <item name="customTextSecondary">@color/dark_text_secondary</item>
        <item name="customTextHint">@color/dark_text_hint</item>
        <item name="customDivider">@color/dark_divider</item>
        <item name="customCardBackground">@color/dark_card_background</item>
        <item name="customIconTint">@color/dark_icon_tint</item>

        <!-- ActionBar для темной темы -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="actionBarSize">56dp</item>
        <item name="actionBarStyle">@style/Widget.CatFeeder.ActionBar.Dark</item>

        <!-- EditText стиль -->
        <item name="editTextStyle">@style/Widget.CatFeeder.EditText.Dark</item>

        <!-- Button стиль -->
        <item name="materialButtonStyle">@style/Widget.CatFeeder.Button</item>
    </style>

    <!-- ActionBar светлый -->
    <style name="Widget.CatFeeder.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/purple_500</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <!-- ActionBar темный -->
    <style name="Widget.CatFeeder.ActionBar.Dark" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/purple_700</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <!-- EditText светлый -->
    <style name="Widget.CatFeeder.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/customTextPrimary</item>
        <item name="android:textColorHint">?attr/customTextHint</item>
    </style>

    <!-- EditText темный -->
    <style name="Widget.CatFeeder.EditText.Dark" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="boxBackgroundColor">?attr/customSurface</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/customTextPrimary</item>
        <item name="android:textColorHint">?attr/customTextHint</item>
    </style>

    <!-- Button стиль -->
    <style name="Widget.CatFeeder.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Маленькая кнопка -->
    <style name="Widget.CatFeeder.Button.Small" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Контурная кнопка -->
    <style name="Widget.CatFeeder.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Диалог -->
    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:background">?attr/customSurface</item>
        <item name="android:textColorPrimary">?attr/customTextPrimary</item>
        <item name="android:textColorSecondary">?attr/customTextSecondary</item>
    </style>

    <!-- Тема без ActionBar -->
    <style name="Theme.CatFeeder.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Атрибуты темы -->
    <attr name="customBackground" format="color|reference" />
    <attr name="customSurface" format="color|reference" />
    <attr name="customTextPrimary" format="color|reference" />
    <attr name="customTextSecondary" format="color|reference" />
    <attr name="customTextHint" format="color|reference" />
    <attr name="customDivider" format="color|reference" />
    <attr name="customCardBackground" format="color|reference" />
    <attr name="customIconTint" format="color|reference" />
</resources>